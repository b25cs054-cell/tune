const INSTRUMENTS = [
  { id: 'synth', name: 'Synthesizer', icon: '🎹', description: 'Bright, warm synth tones with smooth decay' },
  { id: 'piano', name: 'Grand Piano', icon: '🎼', description: 'Acoustic piano timbre with rich resonance' },
  { id: 'strings', name: 'Sustained Strings', icon: '🎻', description: 'Lush ensemble textures with long sustain' },
  { id: 'marimba', name: 'Marimba / Perc', icon: '🪵', description: 'Percussive woody mallet sound with soft rebound' }
];

const MOODS = [
  { id: 'emotional', name: 'Emotional', scale: 'minor', color: 'from-purple-500 to-indigo-600' },
  { id: 'dreamy', name: 'Dreamy', scale: 'major7', color: 'from-blue-400 to-teal-500' },
  { id: 'energetic', name: 'Energetic', scale: 'major', color: 'from-amber-400 to-orange-500' },
  { id: 'dark', name: 'Dark / Cinematic', scale: 'phrygian', color: 'from-red-600 to-slate-900' }
];

export default function App() {
  // Audio state
  const [isPlaying, setIsPlaying] = useState(false);
  const [selectedMelody, setSelectedMelody] = useState(MELODIES[0]);
  const [selectedInstrument, setSelectedInstrument] = useState('synth');
  const [mood, setMood] = useState('emotional');
  const [intensity, setIntensity] = useState(50);
  const [complexity, setComplexity] = useState(40);
  const [bpm, setBpm] = useState(MELODIES[0].tempo);
  const [activeArrangement, setActiveArrangement] = useState(1); // 0: Minimal, 1: Cinematic, 2: Rhythmic
  const [selectedOption, setSelectedOption] = useState(1);
  const [audioInitialized, setAudioInitialized] = useState(false);

  // AI & UI State
  const [aiPrompt, setAiPrompt] = useState('');
  const [isAiProcessing, setIsAiProcessing] = useState(false);
  const [aiExplanation, setAiExplanation] = useState('');
  const [apiKey, setApiKey] = useState('');
  const [showDemoGuide, setShowDemoGuide] = useState(false);
  const [showSettings, setShowSettings] = useState(false);
  const [visualizerData, setVisualizerData] = useState(Array(16).fill(10));

  // Refs for Tone.js elements
  const synthRef = useRef(null);
  const accompanimentSynthRef = useRef(null);
  const melodyPartRef = useRef(null);
  const chordPartRef = useRef(null);
  const arpeggioPartRef = useRef(null);

  // Initialize Tone.js Instruments
  const initAudio = async () => {
    if (audioInitialized) return;
    await Tone.start();
    
    // Main Synth setup
    createInstruments(selectedInstrument);
    Tone.Transport.bpm.value = bpm;
    setAudioInitialized(true);
  };

  const createInstruments = (instType) => {
    // Dispose previous
    if (synthRef.current) synthRef.current.dispose();
    if (accompanimentSynthRef.current) accompanimentSynthRef.current.dispose();

    let mainSynth, accSynth;

    switch (instType) {
      case 'piano':
        mainSynth = new Tone.PolySynth(Tone.Synth, {
          oscillator: { type: 'triangle' },
          envelope: { attack: 0.01, decay: 1.2, sustain: 0.2, release: 1.2 }
        }).toDestination();
        accSynth = new Tone.PolySynth(Tone.Synth, {
          oscillator: { type: 'sine' },
          envelope: { attack: 0.05, decay: 1.5, sustain: 0.4, release: 1.5 }
        }).toDestination();
        break;
      case 'strings':
        mainSynth = new Tone.PolySynth(Tone.Synth, {
          oscillator: { type: 'sawtooth' },
          envelope: { attack: 0.2, decay: 0.5, sustain: 0.8, release: 2.0 }
        }).toDestination();
        accSynth = new Tone.PolySynth(Tone.Synth, {
          oscillator: { type: 'triangle' },
          envelope: { attack: 0.4, decay: 1.0, sustain: 0.9, release: 2.5 }
        }).toDestination();
        break;
      case 'marimba':
        mainSynth = new Tone.PolySynth(Tone.Synth, {
          oscillator: { type: 'sine' },
          envelope: { attack: 0.001, decay: 0.4, sustain: 0.01, release: 0.4 }
        }).toDestination();
        accSynth = new Tone.PolySynth(Tone.Synth, {
          oscillator: { type: 'triangle' },
          envelope: { attack: 0.005, decay: 0.3, sustain: 0.05, release: 0.3 }
        }).toDestination();
        break;
      case 'synth':
      default:
        mainSynth = new Tone.PolySynth(Tone.Synth, {
          oscillator: { type: 'fatsawtooth' },
          envelope: { attack: 0.05, decay: 0.3, sustain: 0.4, release: 0.8 }
        }).toDestination();
        accSynth = new Tone.PolySynth(Tone.FMSynth, {
          harmonicity: 2,
          modulationIndex: 3,
          envelope: { attack: 0.1, decay: 0.5, sustain: 0.3, release: 1.0 }
        }).toDestination();
        break;
    }

    // Set volumes
    mainSynth.volume.value = -4;
    accSynth.volume.value = -12 + (intensity / 100) * 8; // Adjust dynamic volume based on intensity

    synthRef.current = mainSynth;
    accompanimentSynthRef.current = accSynth;
  };

  // Re-build tone schedule whenever options change
  useEffect(() => {
    if (!audioInitialized) return;

    Tone.Transport.cancel();
    createInstruments(selectedInstrument);
    Tone.Transport.bpm.value = bpm;

    // 1. Melody Schedule
    const melodyEvents = selectedMelody.notes.map(n => ({
      time: n.time,
      note: n.note,
      duration: n.duration
    }));

    melodyPartRef.current = new Tone.Part((time, value) => {
      if (synthRef.current) {
        synthRef.current.triggerAttackRelease(value.note, value.duration, time);
      }
    }, melodyEvents).start(0);

    melodyPartRef.current.loop = true;
    melodyPartRef.current.loopEnd = '2:0:0';

    // 2. Accompaniment Schedule based on Active Arrangement Card (Minimal, Cinematic, Rhythmic)
    let chordEvents = [];
    
    if (activeArrangement === 0) {
      // MINIMAL: Simple sustained bass / root chords
      chordEvents = selectedMelody.chords.map(c => ({
        time: c.time,
        notes: [c.notes[0], c.notes[1]],
        duration: '2n'
      }));
    } else if (activeArrangement === 1) {
      // CINEMATIC: Full lush chords with complexity dictating additional notes
      chordEvents = selectedMelody.chords.map(c => {
        const sliceCount = complexity > 50 ? 4 : 3;
        return {
          time: c.time,
          notes: c.notes.slice(0, sliceCount),
          duration: '1n'
        };
      });
    } else {
      // RHYTHMIC: Broken arpeggio pulse
      const arpegNotes = [];
      selectedMelody.chords.forEach((c) => {
        const bar = c.time.split(':')[0];
        const notesToUse = c.notes;
        
        // Add 8th note rhythm
        notesToUse.forEach((note, idx) => {
          if (complexity < 30 && idx > 1) return; // Skip complex notes if complexity low
          arpegNotes.push({
            time: `${bar}:${idx}:0`,
            notes: [note],
            duration: '8n'
          });
        });
      });
      chordEvents = arpegNotes;
    }

    chordPartRef.current = new Tone.Part((time, value) => {
      if (accompanimentSynthRef.current) {
        accompanimentSynthRef.current.triggerAttackRelease(value.notes, value.duration, time);
      }
    }, chordEvents).start(0);

    chordPartRef.current.loop = true;
    chordPartRef.current.loopEnd = '2:0:0';

  }, [selectedMelody, selectedInstrument, activeArrangement, intensity, complexity, bpm, audioInitialized]);

  // Audio Play / Pause handler
  const togglePlay = async () => {
    if (!audioInitialized) {
      await initAudio();
    }
    
    if (isPlaying) {
      Tone.Transport.pause();
      setIsPlaying(false);
    } else {
      Tone.Transport.start();
      setIsPlaying(true);
    }
  };

  const stopPlay = () => {
    Tone.Transport.stop();
    setIsPlaying(false);
  };

  // Switch Instrument dynamically
  const handleInstrumentChange = (instId) => {
    setSelectedInstrument(instId);
    if (audioInitialized) {
      createInstruments(instId);
    }
  };

  // Simulate audio visualizer animation while playing
  useEffect(() => {
    let interval;
    if (isPlaying) {
      interval = setInterval(() => {
        setVisualizerData(
          Array(16)
            .fill(0)
            .map(() => Math.floor(Math.random() * (intensity * 0.7 + 30)) + 10)
        );
      }, 100);
    } else {
      setVisualizerData(Array(16).fill(8));
    }
    return () => clearInterval(interval);
  }, [isPlaying, intensity]);

  // AI Prompt Processor (Gemini Integration + Rule-based Smart Fallback)
  const processAiPrompt = async () => {
    if (!aiPrompt.trim()) return;
    setIsAiProcessing(true);
    setAiExplanation('');

    try {
      if (apiKey) {
        // Direct Gemini API Call if user key supplied
        const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            contents: [{
              parts: [{
                text: `You are an expert music arranger. Translate this mood prompt into JSON settings: "${aiPrompt}".
                Return ONLY valid JSON format matching this schema:
                {
                  "mood": "emotional" | "dreamy" | "energetic" | "dark",
                  "instrument": "synth" | "piano" | "strings" | "marimba",
                  "intensity": number (10-100),
                  "complexity": number (10-100),
                  "arrangementIndex": number (0, 1, or 2),
                  "explanation": "brief 1-sentence explanation"
                }`
              }]
            }]
          })
        });

        const data = await response.json();
        const textResp = data?.candidates?.[0]?.content?.parts?.[0]?.text;
        const cleanedJson = textResp.replace(/```json/g, '').replace(/```/g, '').trim();
        const parsed = JSON.parse(cleanedJson);

        if (parsed) {
          if (parsed.mood) setMood(parsed.mood);
          if (parsed.instrument) handleInstrumentChange(parsed.instrument);
          if (parsed.intensity) setIntensity(parsed.intensity);
          if (parsed.complexity) setComplexity(parsed.complexity);
          if (parsed.arrangementIndex !== undefined) {
            setActiveArrangement(parsed.arrangementIndex);
            setSelectedOption(parsed.arrangementIndex);
          }
          setAiExplanation(parsed.explanation || 'Parameters updated to match your creative description.');
        }
      } else {
        // SMART FALLBACK ENGINE (Simulated Intelligent AI Parsing)
        await new Promise((res) => setTimeout(res, 800)); // natural delay
        const text = aiPrompt.toLowerCase();

        let newMood = 'emotional';
        let newInst = 'piano';
        let newInt = 45;
        let newComp = 30;
        let newArr = 1;
        let reason = '';

        if (text.includes('rain') || text.includes('chill') || text.includes('soft') || text.includes('quiet') || text.includes('night')) {
          newMood = 'dreamy';
          newInst = 'piano';
          newInt = 30;
          newComp = 25;
          newArr = 0; // Minimal
          reason = 'Selected soft piano tones with a minimal, spacious arrangement for a serene atmosphere.';
        } else if (text.includes('epic') || text.includes('movie') || text.includes('cinematic') || text.includes('dark')) {
          newMood = 'dark';
          newInst = 'strings';
          newInt = 85;
          newComp = 75;
          newArr = 1; // Cinematic
          reason = 'Configured rich sustained strings with high intensity for dramatic theatrical depth.';
        } else if (text.includes('dance') || text.includes('upbeat') || text.includes('fast') || text.includes('energy') || text.includes('pop')) {
          newMood = 'energetic';
          newInst = 'synth';
          newInt = 80;
          newComp = 85;
          newArr = 2; // Rhythmic
          reason = 'Applied active synth arpeggios and rhythmic complexity to drive energetic bounce.';
        } else {
          newMood = 'emotional';
          newInst = 'marimba';
          newInt = 50;
          newComp = 40;
          newArr = 1;
          reason = 'Balanced warm organic percussion with a smooth cinematic flow.';
        }

        setMood(newMood);
        handleInstrumentChange(newInst);
        setIntensity(newInt);
        setComplexity(newComp);
        setActiveArrangement(newArr);
        setSelectedOption(newArr);
        setAiExplanation(reason);
      }
    } catch (err) {
      console.error('AI parsing fallback triggered', err);
      setAiExplanation('Applied default balanced settings based on prompt keywords.');
    } finally {
      setIsAiProcessing(false);
    }
  };

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans selection:bg-purple-500 selection:text-white">
      {/* ================= HEADER ================= */}
      <header className="border-b border-slate-800 bg-slate-900/80 backdrop-blur-md sticky top-0 z-40 px-4 lg:px-8 py-3 flex items-center justify-between">
        <div className="flex items-center gap-3">
          <div className="bg-gradient-to-tr from-purple-600 to-cyan-400 p-2 rounded-xl shadow-lg shadow-purple-500/20">
            <Music className="w-6 h-6 text-white animate-pulse" />
          </div>
          <div>
            <h1 className="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-purple-400 via-pink-300 to-cyan-400">
              TuneCraft AI
            </h1>
            <p className="text-xs text-slate-400 hidden sm:block">Your Melody. Your Choices. Your Music.</p>
          </div>
        </div>

        <div className="flex items-center gap-3">
          <span className="hidden md:inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            <span className="w-2 h-2 rounded-full bg-emerald-400 animate-ping" />
            Vercel Ready
          </span>

          <button
            onClick={() => setShowDemoGuide(true)}
            className="flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-semibold bg-purple-600/20 hover:bg-purple-600/30 text-purple-300 border border-purple-500/30 transition"
          >
            <Zap className="w-4 h-4 text-amber-400" />
            90s Hackathon Demo
          </button>

          <button
            onClick={() => setShowSettings(!showSettings)}
            className="p-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition"
            title="Settings & API Key"
          >
            <Settings className="w-4 h-4" />
          </button>
        </div>
      </header>

      {/* ================= SETTINGS MODAL / EXPANDABLE ================= */}
      {showSettings && (
        <div className="bg-slate-900 border-b border-slate-800 p-4 px-4 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4">
          <div className="flex items-center gap-2 text-sm text-slate-300">
            <AlertCircle className="w-4 h-4 text-cyan-400" />
            <span>Optional: Enter Gemini API key to unlock live AI generation logic (Default rule-engine active).</span>
          </div>
          <div className="flex items-center gap-2 w-full md:w-auto">
            <input
              type="password"
              placeholder="Paste Gemini API Key..."
              value={apiKey}
              onChange={(e) => setApiKey(e.target.value)}
              className="px-3 py-1.5 rounded-lg bg-slate-950 border border-slate-700 text-xs text-slate-200 focus:outline-none focus:border-purple-500 w-full md:w-64"
            />
            <button
              onClick={() => setShowSettings(false)}
              className="px-3 py-1.5 bg-purple-600 text-white rounded-lg text-xs font-medium hover:bg-purple-500"
            >
              Save
            </button>
          </div>
        </div>
      )}

      {/* ================= MAIN CONTENT WORKSPACE ================= */}
      <main className="flex-1 max-w-7xl w-full mx-auto p-4 md:p-6 space-y-6">
        
        {/* TOP ROW: MELODY SELECTOR & AI CREATIVE PROMPT */}
        <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
          
          {/* STEP 1: Select Starting Melody */}
          <div className="lg:col-span-5 bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 shadow-xl relative overflow-hidden backdrop-blur-sm">
            <div className="flex items-center justify-between mb-3">
              <div className="flex items-center gap-2">
                <span className="w-6 h-6 rounded-full bg-purple-500/20 text-purple-400 text-xs font-bold flex items-center justify-center border border-purple-500/30">1</span>
                <h2 className="text-base font-semibold text-slate-200">Choose Seed Melody</h2>
              </div>
              <span className="text-xs text-slate-400">{selectedMelody.notes.length} notes</span>
            </div>
